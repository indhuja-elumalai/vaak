# Copy to .env and fill in. At least one of the two keys is required.
SARVAM_API_KEY=
OPENAI_API_KEY=

# auto (Sarvam first, OpenAI on failure) | sarvam | openai
VAAK_STT_PROVIDER=auto
VAAK_TTS_PROVIDER=auto

# Agent LLM: sarvam | openai
VAAK_LLM_PROVIDER=sarvam

# Optional overrides
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe      # or codemix
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
# SARVAM_LLM_MODEL=sarvam-105b
# SARVAM_REASONING_EFFORT=low
# OPENAI_LLM_MODEL=gpt-4o-mini
# VAAK_LLM_TIMEOUT_S=30
